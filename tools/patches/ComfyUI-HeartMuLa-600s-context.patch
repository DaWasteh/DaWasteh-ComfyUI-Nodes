+def validate_duration_context(duration_seconds, prompt_length, max_sequence_length):
+    """Reject requested audio that cannot fit beside the text prompt."""
+    requested_audio_frames = int(float(duration_seconds) * 1000) // 80
+    available_audio_frames = int(max_sequence_length) - int(prompt_length)
+    if requested_audio_frames > available_audio_frames:
+        maximum_seconds = max(0.0, available_audio_frames * 0.08)
+        raise ValueError(
+            f"duration_seconds={duration_seconds:g} exceeds the HeartMuLa context limit "
+            f"for these lyrics/tags. The current prompt allows at most "
+            f"{maximum_seconds:.2f} seconds; shorten the prompt or reduce duration_seconds."
+        )
+    return available_audio_frames * 0.08
+
