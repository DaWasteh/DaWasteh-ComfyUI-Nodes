 device = torch.device(
     "cuda:0") if torch.cuda.is_available() else torch.device("cpu")
 
+
+def _compile_if_supported(model, mode=None):
+    """Avoid TorchInductor/Triton on native Windows ROCm; use eager execution."""
+    if sys.platform == "win32" and torch.version.hip:
+        print("[ComfyUI_YuE] Native Windows ROCm detected: torch.compile disabled.")
+        return model
+    try:
+        kwargs = {"mode": mode} if mode else {}
+        return torch.compile(model, **kwargs)
+    except Exception as exc:
+        print(f"[ComfyUI_YuE] torch.compile unavailable, using eager mode: {exc}")
+        return model
+
+
+def _plan_segment_tokens(target_duration_seconds, max_sections, available_sections, max_new_tokens):
+    """Allocate an exact even number of interleaved codec tokens per section."""
+    section_limit = min(int(max_sections), int(available_sections))
+    token_limit = int(max_new_tokens) // 2 * 2
+    target_tokens = max(2, int(round(float(target_duration_seconds) * 100.0 / 2.0)) * 2)
+    if section_limit < 1:
+        raise ValueError("At least one [section] block is required in lyrics_prompt")
+    if token_limit < 100:
+        raise ValueError("max_new_tokens must be at least 100")
+
+    required_sections = (target_tokens + token_limit - 1) // token_limit
+    if required_sections > section_limit:
+        maximum_seconds = section_limit * token_limit / 100.0
+        raise ValueError(
+            f"target_duration_seconds={target_duration_seconds:g} needs {required_sections} lyric sections, "
+            f"but only {section_limit} are enabled/available. Maximum with the current lyrics and "
+            f"max_new_tokens is {maximum_seconds:.2f} seconds."
+        )
+
+    target_pairs = target_tokens // 2
+    base_pairs, extra_pairs = divmod(target_pairs, required_sections)
+    return [
+        2 * (base_pairs + (1 if index < extra_pairs else 0))
+        for index in range(required_sections)
+    ]
+
+
+def _prepare_reference_audio(reference_audio, start_time, end_time, target_sample_rate=16000):
+    """Convert a ComfyUI AUDIO value to cropped mono audio for YuE ICL."""
+    if not isinstance(reference_audio, dict) or "waveform" not in reference_audio:
+        raise ValueError("reference_audio must be a connected ComfyUI AUDIO input")
+    waveform = reference_audio["waveform"].detach().float().cpu()
+    sample_rate = int(reference_audio.get("sample_rate", target_sample_rate))
+    if waveform.ndim == 3:
+        waveform = waveform[0]
+    if waveform.ndim == 1:
+        waveform = waveform.unsqueeze(0)
+    if waveform.ndim != 2:
+        raise ValueError(f"Unsupported reference_audio shape: {tuple(waveform.shape)}")
+    waveform = waveform.mean(dim=0, keepdim=True)
+
+    start_sample = max(0, int(round(float(start_time) * sample_rate)))
+    end_sample = int(round(float(end_time) * sample_rate))
+    if end_sample <= start_sample:
+        end_sample = waveform.shape[-1]
+    end_sample = min(end_sample, waveform.shape[-1])
+    if start_sample >= end_sample:
+        raise ValueError("The selected reference-audio time range is empty")
+    waveform = waveform[:, start_sample:end_sample]
+    if sample_rate != target_sample_rate:
+        waveform = torchaudio.functional.resample(waveform, sample_rate, target_sample_rate)
+    return waveform
+
