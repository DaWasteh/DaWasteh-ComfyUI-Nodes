+    """Split lyrics at bracketed section headers placed at line starts.
+
+    YuE examples often use simple tags such as ``[Verse]``, but real workflows
+    also use descriptive headers such as ``[Verse 1]`` or
+    ``[Instrumental / Synth Solo]``. The upstream ``\\w+`` parser silently
+    ignored those richer headers and could report only a few available sections.
+    """
+    text = str(lyrics).strip()
+    header_pattern = re.compile(r"(?m)^[ \t]*\[([^\]\r\n]+)\][ \t]*")
+    headers = list(header_pattern.finditer(text))
+    structured_lyrics = []
+    for index, header in enumerate(headers):
+        content_start = header.end()
+        content_end = headers[index + 1].start() if index + 1 < len(headers) else len(text)
+        label = " ".join(header.group(1).split())
+        content = text[content_start:content_end].strip()
+        structured_lyrics.append(f"[{label}]\n{content}\n\n")
     return structured_lyrics
 
