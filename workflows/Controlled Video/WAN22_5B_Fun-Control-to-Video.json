      "title": "Note: About Wan2.2 fun control 5B",
      "properties": {
        "ue_properties": {
          "widget_ue_connectable": {},
          "version": "7.8",
          "input_ue_unconnectable": {}
        }
      },
      "widgets_values": [
        "Since this model only has 5B parameters, the result most of the time will not be very good.\n\nWan2.2-Fun-5B-Control is a multi-language video generation model trained with 121 frames at 24 FPS, supporting various control conditions like Canny, Depth, Pose, and trajectory control for image-to-video tasks."
      ],
      "color": "#432",
      "bgcolor": "#000"
    },
