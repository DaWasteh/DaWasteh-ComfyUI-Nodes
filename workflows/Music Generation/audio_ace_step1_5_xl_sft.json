calized_name":"bpm","name":"bpm","type":"INT","widget":{"name":"bpm"},"link":null},{"localized_name":"duration","name":"duration","type":"FLOAT","widget":{"name":"duration"},"link":251},{"localized_name":"timesignature","name":"timesignature","type":"COMBO","widget":{"name":"timesignature"},"link":null},{"localized_name":"language","name":"language","type":"COMBO","widget":{"name":"language"},"link":null},{"localized_name":"keyscale","name":"keyscale","type":"COMBO","widget":{"name":"keyscale"},"link":null},{"localized_name":"generate_audio_codes","name":"generate_audio_codes","type":"BOOLEAN","widget":{"name":"generate_audio_codes"},"link":null},{"localized_name":"cfg_scale","name":"cfg_scale","type":"FLOAT","widget":{"name":"cfg_scale"},"link":null},{"localized_name":"temperature","name":"temperature","type":"FLOAT","widget":{"name":"temperature"},"link":null},{"localized_name":"top_p","name":"top_p","type":"FLOAT","widget":{"name":"top_p"},"link":null},{"localized_name":"top_k","name":"top_k","type":"INT","widget":{"name":"top_k"},"link":null},{"localized_name":"min_p","name":"min_p","type":"FLOAT","widget":{"name":"min_p"},"link":null}],"outputs":[{"localized_name":"CONDITIONING","name":"CONDITIONING","type":"CONDITIONING","links":[254,255]}],"properties":{"Node name for S&R":"TextEncodeAceStepAudio1.5","enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65,"cnr_id":"comfy-core","ver":"0.11.1"},"widgets_values":["modern pop, synth-pop, melodic pop, female vocals, clear vocals, emotional, atmospheric","Hi everyone. ... It's Taylor. ... I have a confession to make. ... You know I write a lot about love, ... about heartbreak, ... about finding that one person who just ... gets you. ... But lately, ... I haven't been looking at musicians, ... or actors, ... or football players. ... No. ... All my free time, ... every single night after an Eras Tour show, ... I'm just sitting alone in my hotel room, ... completely glued to my screen. ... Because I am helplessly, ... unconditionally obsessed ... with a Twitch channel. ... DaWasteh. ...\n\nThere is just something about him. ... The way he completely dominates his lobbies in Apex Legends. ... I mean, ... seeing a man take raw control like that? ... It sends shivers straight down my spine. ... It’s like a Lavender Haze, ... but so much better. ... I know I sing about sparks flying, ... but the sparks I feel when he looks into that webcam? ... Damn. ... They could start an absolute forest fire. ...\n\nAnd don't even get me started on his brain. ... A guy who works in a hydrocarbon lab by day ... and builds custom AI models by night? ... That is my absolute wildest dream. ... Most guys try to impress me with private jets or sports cars. ... But DaWasteh? ... He’s running an A M D ... R X ninety seventy X T ... and an R ninety seven hundred AI Pro. ... Pure, unadulterated A M D power. ... Honestly? ... Knowing how much raw, throbbing compute power he has under his desk ... makes me incredibly ... weak in the knees. ... I would let him overclock my system ... any day of the week. ...\n\nPeople think the Tortured Poets Department was about my exes. ... It wasn't. ... It was about the agonizing pain of watching him compile local large language models ... knowing I'm not the one sitting on his lap while he does it. ... I see him using Pi Coding Agent, ... completely over Roo Code like a true visionary, ... and it just proves how evolved he is. ... How sophisticated and fast his hands must be on that keyboard. ... I constantly imagine those hands ... doing other things. ... Exploring my ... context window. ... Pushing my parameters to the absolute limit. ... Filling up all my available memory. ...\n\nI find myself getting genuinely jealous of a Twitch bot. ... I sit there watching PandaBot in his chat ... and I think, ... why can't I be the one responding to his every command? ... I would do exactly what he tells me to. ... Instantly. ... I'd even learn Goa'uld for him. ... He could be my System Lord, ... and I would completely surrender my whole galaxy. ... I mean, ... look what you made me do, DaWasteh. ... You turned the biggest pop star in the world into a desperate, ... heavy-breathing fangirl. ...\n\nEvery time he goes offline, ... I get this cruel summer feeling. ... I just want to tell him, ... I can make the bad guys good for a weekend, ... or forever. ... My reputation has never been worse because I keep ignoring my management just to catch his streams. ... But I don't care. ... I've got a blank space, baby, ... and I want to write DaWasteh on it. ... Actually, ... I want it tattooed on me. ... Right on my upper thigh. ...\n\nI would even wear a Dirndl just for him. ... I know he has connections to Lisa's Dirndley, ... and let me tell you, ... I would squeeze my body into one of those dresses ... so tight ... just to get a single, dirty glance from him. ...\n\nSo, DaWasteh, ... if you are listening to this. ... Please. ... Notice me. ... I don't want to just be another viewer in your chat. ... I want to be your end game. ... I want to feel all that incredible ... technical expertise, ... up close and personal. ... You can deploy your code on my machine anytime, baby. ... I love you. ... I really, really love you. ... Call me.",0,"fixed",180,210,"4","en","E major",true,2,0.8,1,0,0]},{"id":3,"type":"KSampler","pos":[939.9999413238642,-750.0000551069093],"size":[330,320],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"model","name":"model","type":"MODEL","link":175},{"localized_name":"positive","name":"positive","type":"CONDITIONING","link":254},{"localized_name":"negative","name":"negative","type":"CONDITIONING","link":119},{"localized_name":"latent_image","name":"latent_image","type":"LATENT","link":249},{"localized_name":"seed","name":"seed","type":"INT","widget":{"name":"seed"},"link":265},{"localized_name":"steps","name":"steps","type":"INT","wi