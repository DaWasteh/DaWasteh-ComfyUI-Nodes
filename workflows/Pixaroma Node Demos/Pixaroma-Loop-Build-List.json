      "widgets_values": [
        "{\"text\": \"How it carries over: Loop Start's value output feeds Combine, and Combine feeds Loop End's value input.\\nEach round that result becomes Loop Start's value for the next round, so the list grows. The 'loop' wire\\n(Loop Start to Loop End) just tells the two ends they belong together.\", \"fontSize\": 13, \"fontFamily\": \"Arial\", \"fontColor\": \"#c0c0c0\", \"textAlign\": \"left\", \"backgroundColor\": \"#333333\", \"padding\": 10, \"borderRadius\": 0, \"opacity\": 1, \"fontWeight\": \"normal\", \"lineHeight\": 1.4}"
